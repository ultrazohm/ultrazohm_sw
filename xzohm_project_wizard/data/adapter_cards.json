    {
      "id": "uz_d_inverter_adapter",
      "name": "UZ_D 3-Phase Inverter",
      "family": "digital",
      "description": "Digital inverter adapter card using uz_d_inverter_adapter plus the mapping IP core.",
      "compatible_slots": [
        "D1",
        "D2",
        "D3",
        "D4"
      ],
      "slot_cpld": "uz_d_3ph_inverter",
      "vivado": {
        "template": "cards/uz_d_inverter_adapter.tcl",
        "notes": [
          "Create a hierarchy for the inverter adapter.",
          "Instantiate uz_d_inverter_adapter and uz_inverter_adapter_mapping_v1_0.",
          "Connect equal-named signals between the IP cores.",
          "Create the slot interface pin and connect it to the mapping IP.",
          "Use the matching packed constraint file for the selected D-slot."
        ],
        "ip_cores": [
          {
            "instance_prefix": "uz_d_inverter_adapter",
            "module": "uz_d_inverter_adapter",
            "vlnv": "user.org:user:uz_d_inverter_adapter:1.0"
          },
          {
            "instance_prefix": "uz_inverter_adapter_mapping",
            "module": "uz_inverter_adapter_mapping_v1_0",
            "vlnv": "user.org:user:uz_inverter_adapter_mapping_v1_0:1.0"
          }
        ],
        "interfaces": [
          {
            "name_template": "{slot}",
            "vlnv": "uz_inverter_adapter_rtl:1.0"
          }
        ],
        "ports": []
      },
      "vitis": {
        "driver": "uz_inverter_adapter",
        "notes": [
          "Generate uz_inverter_adapter_init.c/.h.",
          "Add object pointer to globalData.h.",
          "Initialize the driver in main.c."
        ]
      }
    },
    {
      "id": "uz_d_absolute_encoder",
      "name": "UZ_D Absolute Encoder",
      "family": "digital",
      "description": "Absolute encoder adapter card with three encoder channels. Each channel can be configured independently, e.g. EnDat or SSI.",
      "compatible_slots": [
        "D1",
        "D2",
        "D3",
        "D4",
        "D5"
      ],
      "slot_cpld": "uz_d_abs_encoder",
      "vivado": {
        "template": "cards/generic_card.tcl",
        "notes": [
          "Instantiate one encoder IP core per enabled channel inside uz_user.",
          "Connect AXI4-Lite, 100 MHz clock and reset for every enabled channel.",
          "Connect channel triggers to the intended trigger source.",
          "D-slot channel mappings use Dig_XX_Chx names where x is the slot channel number."
        ],
        "ip_cores": [],
        "interfaces": [],
        "ports": []
      },
      "options": [
        {
          "id": "channel_1",
          "label": "Channel 1 IP core",
          "default": "endat",
          "choices": [
            {
              "id": "none",
              "label": "Not used",
              "vivado": {
                "template": "cards/absolute_encoder_channel.tcl",
                "ip_cores": [],
                "ports": []
              }
            },
            {
              "id": "endat",
              "label": "EnDat",
              "vivado": {
                "template": "cards/absolute_encoder_channel.tcl",
                "ip_cores": [
                  {
                    "instance_prefix": "uz_endat_interface",
                    "module": "uz_endat_interface",
                    "vlnv": "xilinx.com:ip:uz_endat_interface:1.0"
                  }
                ],
                "ports": [
                  {
                    "signal": "endat_clk",
                    "direction": "out",
                    "pin": "Dig_15_Ch{slot_index}"
                  },
                  {
                    "signal": "endat_mode_data_out",
                    "direction": "out",
                    "pin": "Dig_08_Ch{slot_index}"
                  },
                  {
                    "signal": "RW_clk",
                    "direction": "out",
                    "pin": "Dig_17_Ch{slot_index}"
                  },
                  {
                    "signal": "RW_data",
                    "direction": "out",
                    "pin": "Dig_11_Ch{slot_index}"
                  },
                  {
                    "signal": "endat_data_in",
                    "direction": "in",
                    "pin": "Dig_07_Ch{slot_index}"
                  }
                ],
                "axi_interfaces": [
                  {
                    "name": "AXI4_Lite",
                    "path_template": "uz_digital_adapter/{slot}_adapter/uz_endat_interface_{slot_lower}_{option_id}/AXI4_Lite",
                    "addr_seg_template": "uz_digital_adapter/{slot}_adapter/uz_endat_interface_{slot_lower}_{option_id}/AXI4_Lite/reg0"
                  }
                ],
                "trigger_inputs": [
                  {
                    "signal": "trigger_endat_read"
                  }
                ],
                "outputs": [
                  "endat_clk",
                  "endat_mode_data_out",
                  "RW_clk",
                  "RW_data",
                  "endat_transaction_done",
                  "position_raw_single_turn",
                  "position_raw_multi_turn",
                  "CRC_raw",
                  "endat_received_data_out_SH",
                  "position_mech_SI_single_turn",
                  "position_el_SI",
                  "position_multi_turn",
                  "speed_mech_SI",
                  "speed_el_SI",
                  "speed_mech_rpm"
                ]
              },
              "vitis": {
                "driver": "uz_endat_interface"
              }
            },
            {
              "id": "ssi",
              "label": "SSI",
