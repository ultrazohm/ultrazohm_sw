{
  "schema_version": 1,
  "software_drivers": [
    {
      "id": "uz_adc_ltc2311",
      "name": "ADC LTC2311",
      "templates": {
        "header": "software/adc_ltc2311.h.tpl",
        "source": "software/adc_ltc2311.c.tpl"
      },
      "config_fields": [
        {
          "id": "ip_clk_frequency_Hz",
          "label": "IP clock frequency Hz",
          "default": "100000000U"
        },
        {
          "id": "conversion_factor",
          "label": "IP-core conversion factor",
          "default": "1.0f",
          "help": "This value is written into the LTC2311 IP-core channel configuration. It affects the PL-side conversion logic and is independent from the software raw-to-physical factors below."
        },
        {
          "id": "conversion_factor_is_signed",
          "label": "IP-core conversion factor signed",
          "default": "true",
          "help": "Defines whether the IP-core conversion factor is interpreted as signed fixed-point value."
        },
        {
          "id": "conversion_factor_integer_bits",
          "label": "IP-core conversion factor integer bits",
          "default": "14",
          "help": "Integer-bit width of the IP-core fixed-point conversion factor. Keep this consistent with the LTC2311 IP-core configuration."
        },
        {
          "id": "conversion_factor_fractional_bits",
          "label": "IP-core conversion factor fractional bits",
          "default": "4",
          "help": "Fractional-bit width of the IP-core fixed-point conversion factor. Keep this consistent with the LTC2311 IP-core configuration."
        },
        {
          "id": "offset",
          "label": "IP-core offset",
          "default": "0"
        },
        {
          "id": "samples",
          "label": "Samples",
          "default": "1U"
        },
        {
          "id": "sample_time",
          "label": "Sample time",
          "default": "6U"
        },
        {
          "id": "trigger_mode",
          "label": "Trigger mode",
          "default": "pl_trigger"
        },
        {
          "id": "cpol",
          "label": "CPOL",
          "default": "1U"
        },
        {
          "id": "cpha",
          "label": "CPHA",
          "default": "0U"
        },
        {
          "id": "napping_spi_masters",
          "label": "Napping SPI masters",
          "default": "0U"
        },
        {
          "id": "sleeping_spi_masters",
          "label": "Sleeping SPI masters",
          "default": "0U"
        },
        {
          "id": "master_select",
          "label": "Master select",
          "default": "UZ_ADCLTC2311_MASTER1"
        },
        {
          "id": "channel_select",
          "label": "Channel select",
          "default": "UZ_ADCLTC2311_CH1 | UZ_ADCLTC2311_CH2 | UZ_ADCLTC2311_CH3 | UZ_ADCLTC2311_CH4 | UZ_ADCLTC2311_CH5 | UZ_ADCLTC2311_CH6 | UZ_ADCLTC2311_CH7 | UZ_ADCLTC2311_CH8"
        },
        {
          "id": "pre_delay",
          "label": "Pre delay",
          "default": "0U"
        },
        {
          "id": "post_delay",
          "label": "Post delay",
          "default": "0U"
        },
        {
          "id": "clk_div",
          "label": "Clock divider",
          "default": "0U"
        },
        {
          "id": "max_attempts",
          "label": "Max attempts",
          "default": "10U"
        },
        {
          "id": "software_raw_to_physical_value_factor_ch0",
          "label": "Software raw-to-physical factor channel 0",
          "default": "10.0f",
          "help": "Software-only bipolar full-span scale factor used by uz_adcLtc2311_convert_raw_to_physical_value(). It does not configure the IP core. The raw ADC value is treated as signed int16_t differential/bipolar data. The formula is raw / 65536.0f * full_span_factor, so a factor of 10.0f maps the signed range approximately to -5.0 ... +5.0."
        },
        {
          "id": "software_raw_to_physical_value_factor_ch1",
          "label": "Software raw-to-physical factor channel 1",
