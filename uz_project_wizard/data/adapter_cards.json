{
  "schema_version": 1,
  "cards": [
    {
      "id": "empty",
      "name": "Empty slot",
      "family": "system",
      "description": "No adapter card installed.",
      "compatible_slots": ["A1", "A2", "A3", "D1", "D2", "D3", "D4", "D5"],
      "vivado": {
        "notes": ["No TCL commands are emitted for empty slots."],
        "ip_cores": [],
        "interfaces": [],
        "ports": []
      },
      "vitis": {
        "driver": "",
        "notes": []
      }
    },
    {
      "id": "uz_d_absolute_encoder_endat",
      "name": "UZ_D Absolute Encoder - EnDat",
      "family": "digital",
      "description": "Absolute encoder adapter card using the uz_endat_interface IP core. Initial mapping is based on the documentation example and needs validation before production use.",
      "compatible_slots": ["D1", "D2", "D3", "D4", "D5"],
      "vivado": {
        "notes": [
          "Instantiate uz_endat_interface inside uz_user.",
          "Connect AXI4-Lite, 100 MHz clock and reset.",
          "Connect trigger_endat to uz_system/trigger_conversions.",
          "D-slot channel mappings use Dig_XX_Chx names where x is the slot channel number."
        ],
        "ip_cores": [
          {
            "instance_prefix": "uz_endat_interface",
            "module": "uz_endat_interface",
            "vlnv": "user.org:user:uz_endat_interface:1.0"
          }
        ],
        "interfaces": [],
        "ports": [
          {"signal": "endat_clk", "direction": "out", "channel_1_pin": "Dig_15_Ch{slot_index}"},
          {"signal": "endat_mode_data_out", "direction": "out", "channel_1_pin": "Dig_08_Ch{slot_index}"},
          {"signal": "RW_clk", "direction": "out", "channel_1_pin": "Dig_17_Ch{slot_index}"},
          {"signal": "RW_data", "direction": "out", "channel_1_pin": "Dig_11_Ch{slot_index}"},
          {"signal": "endat_data_in", "direction": "in", "channel_1_pin": "Dig_07_Ch{slot_index}"}
        ]
      },
      "vitis": {
        "driver": "uz_endat_interface",
        "notes": [
          "Generate uz_endat_interface_init.c/.h.",
          "Add object pointer to globalData.h.",
          "Initialize and enable the IP in main.c after xparameters.h contains the base address."
        ]
      }
    },
    {
      "id": "uz_d_inverter_adapter",
      "name": "UZ_D 3-Phase Inverter",
      "family": "digital",
      "description": "Digital inverter adapter card using uz_d_inverter_adapter plus the mapping IP core.",
      "compatible_slots": ["D1", "D2", "D3", "D4"],
      "vivado": {
        "notes": [
          "Create a hierarchy for the inverter adapter.",
          "Instantiate uz_d_inverter_adapter and uz_inverter_adapter_mapping_v1_0.",
          "Connect equal-named signals between the IP cores.",
          "Create the slot interface pin and connect it to the mapping IP.",
          "Use the matching packed constraint file for the selected D-slot."
        ],
        "ip_cores": [
          {
            "instance_prefix": "uz_d_inverter_adapter",
            "module": "uz_d_inverter_adapter",
            "vlnv": "user.org:user:uz_d_inverter_adapter:1.0"
          },
          {
            "instance_prefix": "uz_inverter_adapter_mapping",
            "module": "uz_inverter_adapter_mapping_v1_0",
            "vlnv": "user.org:user:uz_inverter_adapter_mapping_v1_0:1.0"
          }
        ],
        "interfaces": [
          {
            "name_template": "{slot}",
            "vlnv": "uz_inverter_adapter_rtl:1.0"
          }
        ],
        "ports": []
      },
      "vitis": {
        "driver": "uz_inverter_adapter",
        "notes": [
          "Generate uz_inverter_adapter_init.c/.h.",
          "Add object pointer to globalData.h.",
          "Initialize the driver in main.c."
        ]
      }
    },
    {
      "id": "uz_d_temperature_ltc2983",
      "name": "UZ_D Temperature LTC2983",
      "family": "digital",
      "description": "Temperature measurement adapter card using the Temperature_Card_Interface IP core.",
      "compatible_slots": ["D1", "D2", "D3", "D4"],
      "vivado": {
        "notes": [
          "Instantiate Temperature_Card_Interface in uz_user.",
          "Use single-pin D-slot constraints instead of the packed constraint file.",
          "D5 requires a custom CPLD file and is intentionally not listed as compatible."
        ],
        "ip_cores": [
          {
            "instance_prefix": "temperature_card_interface",
            "module": "Temperature_Card_Interface",
            "vlnv": "user.org:user:Temperature_Card_Interface:1.0"
          }
        ],
        "interfaces": [],
        "ports": []
      },
      "vitis": {
        "driver": "temperature_card_interface",
        "notes": []
      }
    }
  ]
}
