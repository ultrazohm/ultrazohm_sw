        <PORT DIR="I" NAME="capturetrig0" SIGIS="undef"/>
        <PORT DIR="I" NAME="capturetrig1" SIGIS="undef"/>
        <PORT DIR="O" NAME="generateout0" SIGIS="undef"/>
        <PORT DIR="O" NAME="generateout1" SIGIS="undef"/>
        <PORT DIR="O" NAME="pwm0" SIGIS="undef"/>
        <PORT DIR="O" NAME="interrupt" SENSITIVITY="LEVEL_HIGH" SIGIS="INTERRUPT" SIGNAME="Interrupt_Trigger_f_cc_interrupt">
          <CONNECTIONS>
            <CONNECTION INSTANCE="Interrupt_Concat_interrupts" PORT="In6"/>
            <CONNECTION INSTANCE="Interrupt_ila_0" PORT="probe6"/>
