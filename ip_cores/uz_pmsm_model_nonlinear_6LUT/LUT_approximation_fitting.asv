%Fitting_fluxlinkage_approximation
close all;
%LUT Fitting

%LeastSquare Problems
% 1. Gleichung
Fluxd_iqnull = Flux_d(:,10)';
Fluxd_iqnull = Fluxd_iqnull+ rand(1,length(Fluxd_iqnull))
% test = Flux_d(:,10)'.*0.5;
fun1=@(ad,d_current_d_Flux)ad(1)*tanh(ad(2)*d_current_d_Flux)+ad(3)*d_current_d_Flux;
beta1 = [-0.0003;96.1725;0.0002];
% opts = statset('nlinfit');
% opts.RobustWgtFun = 'bisquare';
ad = nlinfit(d_current_d_Flux,Fluxd_iqnull,fun1,beta1)
% ad = lsqcurvefit(fun1,beta1,d_current_d_Flux,test)
%Einfach ein anderer solver
% options = optimoptions('lsqcurvefit','Algorithm','levenberg-marquardt');
% lb = [];
% ub = [];
% test2 = lsqcurvefit(fun,beta0,d_current_d_Flux,fluxdtest,lb,ub,options)

% Fluxd_iqnull_fitted = Fluxd_iqnull-ad(1)*tanh(ad(2)*d_current_d_Flux)-ad(3)*d_current_d_Flux;
Fluxd_iqnull_fitted = fun1(ad, d_current_d_Flux);

% 2. Gleichung
Fluxq_idnull = Flux_q(15,:)';
fun2=@(aq,q_current_d_Flux)Fluxq_idnull-aq(1)*tanh(aq(2)*q_current_d_Flux)-aq(3)*q_current_d_Flux;
beta2 = [1;1;1];
aq = nlinfit(q_current_d_Flux,Fluxq_idnull,fun2,beta2);
Fluxq_idnull_fitted = Fluxq_idnull-aq(1)*tanh(aq(2)*q_current_d_Flux)-aq(3)*q_current_d_Flux;

% 3. Gleichung
Fluxd_iq1 = Flux_d(:,20)';
fun3=@(ad_zwei,d_current_d_Flux)Fluxd_iq1-ad_zwei(1)*tanh(ad_zwei(2)*d_current_d_Flux)-ad_zwei(3)*d_current_d_Flux;
beta3 = [1;1;1];
ad_zwei = nlinfit(d_current_d_Flux,Fluxd_iq1,fun3,beta3);
Fluxd_iq1_fitted = Fluxd_iq1-ad_zwei(1)*tanh(ad_zwei(2)*d_current_d_Flux)-ad_zwei(3)*d_current_d_Flux;

% 4. Gleichung
Fluxq_id1 = Flux_q(1,:)';
fun4=@(aq_zwei,q_current_d_Flux)Fluxq_id1-aq_zwei(1)*tanh(aq_zwei(2)*q_current_d_Flux)-aq_zwei(3)*q_current_d_Flux;
beta4 = [1;1;1];
aq_zwei = nlinfit(q_current_d_Flux,Fluxq_id1,fun4,beta4);
Fluxq_id1_fitted = Fluxq_id1-aq_zwei(1)*tanh(aq_zwei(2)*q_current_d_Flux)-aq_zwei(3)*q_current_d_Flux;

figure;
% Erster Plot
subplot(2,1,1); % Erstelle das obere Subplot
grid on;
plot(d_current_d_Flux, Fluxd_iqnull_fitted, 'DisplayName', 'Fluxd_iqnull_fitted');
hold on;
plot(d_current_d_Flux, Fluxd_iqnull, 'DisplayName', 'Fluxd_iqnull');
legend('show');

% Zweiter Plot
subplot(2,1,2); % Erstelle das untere Subplot
grid on;
plot(d_current_d_Flux, test);
% surf(d_current_q_Flux, q_current_q_Flux, psi_q');
% xlabel('D Current');
% ylabel('Q Current');
legend;


%Alte Funktionsversuche
% function F=fun(ad1,ad2,ad3)
% fun=Flux_d(7,:)-ad1*tanh(ad2*d_current_d_Flux(:))+ad3*d_current_d_Flux(:)
% end 
% fun=@(ad1,ad2,ad3)Flux_d(7,:)-ad1*tanh(ad2*d_current_d_Flux(:))+ad3*d_current_d_Flux(:);
%Parameterfinding 
% fun=@(ad1,ad2,ad3)Flux_d(:,7)-ad1.*tanh(ad2.*d_current_d_Flux(:))+ad3.*d_current_d_Flux(:);
% x0=[10 1 1];
% x=lsqnonlin(fun,x0)
% 
% for j = 1:size(d_current_q_Flux')
% (Flux_d(7,j)-ad1*tanh(ad2*d_current_d_Flux(j))+ad3*d_current_d_Flux(j))^2;
% end
% test = min()

% syms ad1 ad2 ad3 ad4 ad5 ad6 aq1 aq2 aq3 aq4 aq5 aq6;
% syms id iq;

%Maximum Crosscoupling current constants id1 und iq1

%Selbstinduktion
psidself = ad(1)*tanh(ad(2)*d_current_q_Flux)+ad(3)*d_current_q_Flux;
psiqself = aq(1)*tanh(aq(2)*q_current_d_Flux)+aq(3)*q_current_d_Flux;

%gesamte induktion in im maximalen kreuzekkopplungsstrom (also ein
%ausgewählter betriebspuntk) 
psid_s1 = ad_zwei(1)*tanh(ad_zwei(2)*d_current_q_Flux)+ad_zwei(3)*d_current_q_Flux;
psiq_s1 = aq_zwei(1)*tanh(aq_zwei(2)*q_current_d_Flux)+aq_zwei(3)*q_current_d_Flux;

%dann ist die Kreuzkopplungin diesem Punkt 
psid_cross_s1 = psidself - psid_s1;
psiq_cross_s1 = psiqself - psiq_s1;

%die beiden werden dann integriert (wieso auch immer) 
psiid_cross_s1_integrated = (1/2)*(ad(3)-ad_zwei(3))*((d_current_q_Flux).^2)+((ad(1)/ad(2))*log(cosh(ad(2)*d_current_q_Flux)))-((ad_zwei(1)/ad_zwei(2))*log(cosh(ad_zwei(2)*d_current_q_Flux)));

psiiq_cross_s1_integrated = (1/2)*(aq(3)-aq_zwei(3))*((q_current_q_Flux).^2)+((aq(1)/aq(2))*log(cosh(aq(2)*q_current_q_Flux)))-((aq_zwei(1)/aq_zwei(2))*log(cosh(aq_zwei(2)*q_current_q_Flux)));

%jetzt ist noch die Frage wie in dem einen Paper auf die genaue
%Kruezkopplung gekommen wird weil der einfach die beiden
%kreuezkopplungsterme in dem betriebspunkt mit den integration
%multipliziert werden und dann hat man plötzlich die kreuzkopplung

% Fid1_Giq1 = (1/2)*(aq(3)-aq_zwei(3))*((q_current_q_Flux).^2)+((aq(1)/aq(2))*log(cosh(aq(2)*q_current_q_Flux)))-((aq_zwei(1)/aq_zwei(2))*log(cosh(aq_zwei(2)*q_current_q_Flux)));
Fid1_Giq1=1;
psi_d_cross = (1/Fid1_Giq1).*(psid_cross_s1).*(psiiq_cross_s1_integrated);
psi_q_cross = (1/Fid1_Giq1).*(psiq_cross_s1).*(psiid_cross_s1_integrated);


psi_d = psidself - psi_d_cross;
psi_q = psiqself - psi_q_cross;

figure;
% Erster Plot
subplot(2,1,1); % Erstelle das obere Subplot
grid on;
% plot(q_current_q_Flux, Fluxd_iqnull_fitted);
surf(d_current_q_Flux, q_current_q_Flux, psi_d);
xlabel('D Current');
ylabel('Q Current');
zlabel('Flux_d');

legend;

% Zweiter Plot
subplot(2,1,2); % Erstelle das untere Subplot
grid on;
% plot(q_current_q_Flux, Fluxd_iqnull);
surf(d_current_q_Flux, q_current_q_Flux, psi_q);
xlabel('D Current');
ylabel('Q Current');
zlabel('Flux_d');
legend;


