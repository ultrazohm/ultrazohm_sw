set_property PACKAGE_PIN AB8 [get_ports DAC_IN_N7_A1]
set_property PACKAGE_PIN AE9 [get_ports DAC_IN_P8_A1]
set_property PACKAGE_PIN AE8 [get_ports DAC_IN_N8_A1]

set_property IOSTANDARD LVDS [get_ports DAC_CLK_P_A1]
set_property IOSTANDARD LVDS [get_ports DAC_CLK_N_A1]
