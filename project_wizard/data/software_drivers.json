          "default": "UZ_ADCMAX11331_PL_TRIGGER"
        },
        {
          "id": "adc_delay_offset",
          "label": "ADC delay offset",
          "default": "0U"
        },
        {
          "id": "clk_div",
          "label": "SPI clock divider",
