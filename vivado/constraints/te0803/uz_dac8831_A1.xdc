### Analog DAC8831 Adapter Board A1
# Derived from the A-slot adapter-board pin mapping and uz_dac8831_A3.xdc.

set_property PACKAGE_PIN AF7 [get_ports DAC_CLK_P_A1]
set_property PACKAGE_PIN AF6 [get_ports DAC_CLK_N_A1]
set_property PACKAGE_PIN AC9 [get_ports DAC_CVN_P_A1]
set_property PACKAGE_PIN AD9 [get_ports DAC_CVN_N_A1]

set_property PACKAGE_PIN AH8 [get_ports DAC_IN_P1_A1]
set_property PACKAGE_PIN AH7 [get_ports DAC_IN_N1_A1]
